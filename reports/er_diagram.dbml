Table roles {
  id bigint [pk, increment]
  name text [not null]
  description text
}

Table users {
  id bigint [pk, increment]
  first_name text [not null]
  last_name text [not null]
  phone text [not null]
  email text
  created_at timestamptz [not null]
}

Table user_roles {
  user_id bigint [not null]
  role_id bigint [not null]
  assigned_at timestamptz [not null]
  indexes { (user_id, role_id) [pk] }
}

Table salons {
  id bigint [pk, increment]
  name text [not null]
  address text [not null]
  phone text
  owner_id bigint
  created_at timestamptz [not null]
}

Table masters {
  id bigint [pk, increment]
  user_id bigint [not null]
  salon_id bigint [not null]
  specialization text
  bio text
  created_at timestamptz [not null]
}

Table categories {
  id bigint [pk, increment]
  name text [not null]
  description text
  created_at timestamptz [not null]
}

Table services {
  id bigint [pk, increment]
  name text [not null]
  description text
  price numeric(10,2)
  category_id bigint
  created_at timestamptz [not null]
}

Table master_services {
  master_id bigint [not null]
  service_id bigint [not null]
  price numeric(10,2)
  duration_min integer [not null]
  indexes { (master_id, service_id) [pk] }
}

Table working_schedules {
  id bigint [pk, increment]
  master_id bigint [not null]
  work_date date [not null]
  start_time time [not null]
  end_time time [not null]
}

Table appointments [headercolor: #c0392b] {
  id bigint [pk, increment]
  client_id bigint [not null]
  master_id bigint [not null]
  service_id bigint [not null]
  start_at timestamptz [not null]
  end_at timestamptz [not null]
  status text [not null]
  price_total numeric(10,2)
  created_at timestamptz [not null]
  Note: 'ТАБЛИЦА-ФАКТ: к неделе 4 вырастет до 300 000 строк'
}

Table reviews {
  id bigint [pk, increment]
  appointment_id bigint [not null]
  rating smallint [not null]
  comment text
  created_at timestamptz [not null]
}

Ref: user_roles.user_id > users.id
Ref: user_roles.role_id > roles.id
Ref: salons.owner_id > users.id
Ref: masters.user_id > users.id
Ref: masters.salon_id > salons.id
Ref: services.category_id > categories.id
Ref: master_services.master_id > masters.id
Ref: master_services.service_id > services.id
Ref: working_schedules.master_id > masters.id
Ref: appointments.client_id > users.id
Ref: appointments.master_id > masters.id
Ref: appointments.service_id > services.id
Ref: reviews.appointment_id - appointments.id